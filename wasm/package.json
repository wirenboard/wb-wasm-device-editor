{
  "name": "wb-wasm-device-editor",
  "version": "1.8.4",
  "author": "Wiren Board team",
  "description": "Wirenboard WASM-based device editor",
  "scripts": {
    "dev": "vite dev --host",
    "prebuild": "mkdir -p public/vendor && cp node_modules/@cmuav/web-serial-polyfill/dist/serial.js public/vendor/web-serial-polyfill.js",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "npx eslint --cache --cache-location .eslintcache",
    "lint:fix": "npx eslint --fix",
    "test:e2e": "npx playwright test --config=e2e/playwright.config.ts"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/express": "^5.0.6",
    "@types/react": "18.2.0",
    "@types/react-dom": "18.2.0",
    "@vitejs/plugin-react": "5.0.4",
    "@wirenboard/eslint": "1.7.0",
    "eslint": "9.39.1",
    "express": "^5.2.1",
    "path-type": "^6.0.0",
    "typescript": "5.7.3",
    "vite": "7.3.0",
    "vite-plugin-commonjs": "0.10.4",
    "vite-plugin-svgr": "^4.5.0"
  },
  "dependencies": {
    "@cmuav/web-serial-polyfill": "^1.2.0",
    "date-fns": "^4.1.0"
  }
}
